# ========================================
# CONFIGURACIÓN DEL ADMIN PARA NGROK
# ========================================
# 
# Este archivo configura la URL del backend
# para que el admin pueda conectarse a través
# de ngrok durante desarrollo
#
# IMPORTANTE: La URL de ngrok cambia cada vez
# que reinicias ngrok. Actualiza esta variable
# con la nueva URL cuando sea necesario.
#
# Para obtener tu URL de ngrok:
# 1. Abre: http://127.0.0.1:4040
# 2. Copia la URL "Forwarding" (ej: https://xxx.ngrok-free.dev)
# 3. Agrega /api/v1 al final
# ========================================

NEXT_PUBLIC_API_URL=https://undefaceable-kristyn-unreligiously.ngrok-free.dev/api/v1

# ========================================
# PARA PRODUCCIÓN:
# Cambia a tu dominio real cuando despliegues:
# NEXT_PUBLIC_API_URL=https://tuapp.com/api/v1
# ========================================
